{
"about": "How an app uses the building tiles in this folder. See README.md beside this file for the whole story.",
"cell": 32,
"level": 16,
"placement": "a piece at cell (x, y), level k, whose ground tile has its top left at (gx, gy): draw its picture with its top left at (gx, gy - 16 * (k + levels)), levels being 1 (a 32 x 32 picture) or 2 (a 32 x 48 one)",
"groundTile": "the cell's ground tile top left is (16 * (x - y), 8 * (x + y)) plus the map's own offset, as the terrain page draws it",
"drawOrder": "sort by x + y, then by level, and draw in that order, after the ground tiles",
"storey": 2,
"sheetColumns": 8,
"frameOrder": "in a sheet, each piece is its NE picture then its SE picture; the frame is col + row * columns",
"orientation": {
"NE": "the feature or slope is on the wall or run that goes NE-SW (the right-hand wall as seen)",
"SE": "the feature or slope is on the wall or run that goes NW-SE (the left-hand wall as seen)",
"NW and SW": "flip the NE and SE pictures left to right, as for the characters"
},
"roof": {
"rise": "one level over one cell",
"endsMatch": {
"tile": "timber plaster",
"slate": "stone",
"teal": "stone"
}
},
